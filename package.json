{
  "name": "projectplanning",
  "version": "0.1.0",
  "private": true,
  "description": "Kanban and Gantt planning site for GitHub issues tracked on Projects (v2) boards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "data:fixtures": "tsx scripts/sync.ts --fixtures",
    "fixtures:generate": "tsx scripts/generate-fixture.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrei-kochin/ProjectPlanning.git"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
